{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "NODE_ENV",
    "JWT_SECRET",
    "PUBLIC_URL"
  ],
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build",
        "^db:generate"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^db:generate"
      ],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^db:generate"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^db:generate"
      ],
      "cache": false
    }
  }
}
