generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum values match the public API contract (docs/openapi.yaml) so no mapping is needed.

enum UserRole {
  buyer
  supplier
  admin
}

enum Language {
  en
  ru
  tj
}

enum SupplierStatus {
  pending
  verified
  suspended
}

enum RfqStatus {
  open
  quoted
  awarded
}

enum OrderStatus {
  placed
  confirmed
  out_for_delivery
  delivered
  confirmed_receipt
}

enum PaymentMethod {
  cod
  bank_transfer
}

model User {
  id         String    @id @default(cuid())
  phone      String    @unique
  name       String?
  role       UserRole  @default(buyer)
  language   Language  @default(ru)
  // Set for supplier staff accounts.
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  rfqs    Rfq[]
  orders  Order[]
  reviews Review[]
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Supplier {
  id          String         @id @default(cuid())
  name        String
  status      SupplierStatus @default(pending)
  // Denormalised from reviews, updated when a review is submitted.
  rating      Float          @default(0)
  reviewCount Int            @default(0)
  // LocalizedText { en, ru, tj }
  location    Json
  phones      String[]
  languages   Language[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  users    User[]
  products Product[]
  quotes   Quote[]
  orders   Order[]
  reviews  Review[]
}

model Category {
  // Stable slug, e.g. "cement".
  id        String    @id
  // LocalizedText { en, ru, tj }
  name      Json
  icon      String
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  // LocalizedText fields. Supplier-written text is stored as given.
  name       Json
  unit       Json
  attributes Json
  price      Decimal  @db.Decimal(12, 2)
  stock      Int      @default(0)
  imageUrl   String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  wholesaleTiers WholesaleTier[]
  rfqItems       RfqItem[]
  orderLines     OrderLine[]

  @@index([categoryId])
  @@index([supplierId])
}

model WholesaleTier {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty       Int
  pricePerUnit Decimal @db.Decimal(12, 2)

  @@unique([productId, minQty])
}

model Rfq {
  id               String    @id @default(cuid())
  buyerId          String
  buyer            User      @relation(fields: [buyerId], references: [id])
  deliveryLocation String
  neededBy         DateTime  @db.Date
  status           RfqStatus @default(open)
  awardedQuoteId   String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items  RfqItem[]
  quotes Quote[]

  @@index([buyerId, createdAt(sort: Desc)])
  @@index([status])
}

model RfqItem {
  id        String  @id @default(cuid())
  rfqId     String
  rfq       Rfq     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(12, 3)

  @@index([rfqId])
}

model Quote {
  id           String   @id @default(cuid())
  rfqId        String
  rfq          Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  total        Decimal  @db.Decimal(12, 2)
  deliveryDays Int
  // LocalizedText { en, ru, tj }
  note         Json
  createdAt    DateTime @default(now())

  @@unique([rfqId, supplierId])
  @@index([rfqId])
}

model Order {
  id                String        @id @default(cuid())
  buyerId           String
  buyer             User          @relation(fields: [buyerId], references: [id])
  supplierId        String
  supplier          Supplier      @relation(fields: [supplierId], references: [id])
  total             Decimal       @db.Decimal(12, 2)
  paymentMethod     PaymentMethod
  status            OrderStatus   @default(placed)
  deliveryAddress   String
  receiptConfirmedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  lines      OrderLine[]
  review     Review?
  commission Commission?

  @@index([buyerId, createdAt(sort: Desc)])
  @@index([supplierId, createdAt(sort: Desc)])
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(12, 3)
  // Server-calculated at order creation.
  unitPrice Decimal @db.Decimal(12, 2)
}

model Review {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  orderId    String?  @unique
  order      Order?   @relation(fields: [orderId], references: [id])
  rating     Int
  comment    String
  createdAt  DateTime @default(now())

  @@index([supplierId, createdAt(sort: Desc)])
}

// Accrued only when the buyer confirms receipt (business model section 4).
model Commission {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  rate      Decimal  @db.Decimal(5, 4)
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
}
