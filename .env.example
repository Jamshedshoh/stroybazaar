DATABASE_URL="postgresql://postgres:postgres@localhost:5433/stroybazaar?schema=public"

# Shared by api and admin-api to sign/verify login tokens. Required in production.
JWT_SECRET="change-me"

# api
COMMISSION_RATE=0.02
# DEMO_ENDPOINTS=true       # defaults to true outside production
# OTP_RATE_LIMIT=10         # OTP requests per IP per 15 minutes

# `pnpm db:seed` makes this phone number an admin (log in through the api's OTP flow).
ADMIN_PHONE="+992900000000"
